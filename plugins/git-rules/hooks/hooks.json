{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/branch_name/rule.py" }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/work_branch/rule.py" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/commit_message/rule.py" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/branch_name/rule.py" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/work_branch/rule.py" }
        ]
      }
    ]
  }
}
