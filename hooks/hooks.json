{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/one_command.py" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/branch_name.py" },
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/commit_message.py" }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/new_files_only.py" }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/no_hard_wrap.py" }
        ]
      }
    ]
  }
}
